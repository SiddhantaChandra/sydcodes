# Cloudflare Turnstile test credentials for local development.
# Replace with production widget credentials for deployment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Gmail SMTP credentials are required only to deliver contact form messages.
# GMAIL_USER is both the sender and recipient address.
GMAIL_USER=
GMAIL_APP_PASSWORD=
